<h2>لیست معلمان</h2>
<button type="button"
        class="btn btn-primary"
        id="btnCreateTeacher">
    افزودن معلم
</button>
<table class="table">
    <thead>
        <tr>
            <th>شناسه</th>
            <th>نام</th>
            <th>نام خانوادگی</th>
            <th>عملیات</th>
        </tr>
    </thead>

    <tbody id="teachersTable">
    </tbody>
</table>


<!-- #region Modal -->

<div class="modal fade" id="teacherModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form id="teacherForm"
                  asp-controller="Teacher"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="teacherModalTitle">
                        ایجاد معلم
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" name="Id" value="0" />

                    <div class="mb-3">
                        <label class="form-label">نام</label>
                        <input type="text" name="FirstName"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">نام خانوادگی</label>
                        <input type="text" name="LastName"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">کد ملی</label>
                        <input type="text" name="NationalCode"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">سن</label>
                        <input type="number" name="Age"
                               class="form-control" />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        بستن
                    </button>

                    <button type="submit" class="btn btn-primary"
                            id="teacherSubmitButton">
                        ثبت معلم
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>


<!-- #endregion -->




<!-- #region js -->

@section Scripts {
    <script src="~/js/teachers/common.js"></script>
    <script src="~/js/teachers/index.js"></script>
    <script src="~/js/teachers/teacher-form.js"></script>
    <script src="~/js/teachers/delete.js"></script>
}
<!-- #endregion -->